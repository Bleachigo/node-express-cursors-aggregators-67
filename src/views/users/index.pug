doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    link(rel="icon", href="/favicon.ico")
    title All users
    link(rel="stylesheet" href="/css/styles.css")
  body(class=theme) 
    h1 Users

    if users.length
      each user in users
        div(class="user-card")
          h2= user.email
          p= user.id
    else
      p No users yet
