<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <link rel="icon" href="/favicon.ico" />
  <link rel="stylesheet" href="/css/styles.css" />
  <title>Articles</title>
</head>

  <body class="<%= theme %>">
    <h1>Articles</h1>
    <% articles.forEach(article => { %>
      <article>
        <h2><%= article.title %></h2>
        <p><%= article.body %></p>
        <a href="#">
         Read article
        </a>
      </article>
    <% }) %>
  </body>

</html>
